{
  // Volgo op je eigen Cloudflare-account.
  // De database-id wordt bij elke deploy automatisch ingevuld door GitHub Actions.
  "name": "volgo",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  // Elke ochtend 06:00 UTC (07:00 winter, 08:00 zomer): ochtendsamenvatting per mail.
  // Eigen domein (Cloudflare maakt DNS en certificaat automatisch aan). workers.dev blijft ook werken.
  "routes": [
    { "pattern": "thevolgo.app", "custom_domain": true },
    { "pattern": "www.thevolgo.app", "custom_domain": true }
  ],
  "workers_dev": true,
  "triggers": { "crons": ["0 6 * * *"] },
  "vars": { "HF_ENV": "production", "APP_SLUG": "volgo", "ADMIN_EMAILS": "damienhanssens@outlook.com,hanssenscornerstone@outlook.com,volgo.app@outlook.com" },
  "d1_databases": [
    { "binding": "DB", "database_name": "volgo-db", "database_id": "__D1_ID__", "migrations_dir": "migrations" }
  ]
}
